# העתק/י לקובץ .env באותה תיקייה כדי להפעיל את שכבת ההסבר AI. אופציונלי לגמרי —
# בלי הקובץ הזה (או בלי AI_PROVIDER מוגדר) שאר השירות ממשיך לעבוד רגיל, כולל
# admin.html — פשוט בלי כפתור "הסבר AI".

# ספק שכבת ההסבר. כרגע יש תמיכה רק ב-anthropic. השאר ריק/מחוק את השורה כדי להשבית.
AI_PROVIDER=anthropic

# מפתח ה-API בפועל — לעולם לא לשים כאן ולא לשים ב-git. .env נמצא כבר ב-.gitignore.
ANTHROPIC_API_KEY=

# אופציונלי — ברירת מחדל: claude-sonnet-5
AI_MODEL=claude-sonnet-5
