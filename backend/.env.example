# Placeholders only. Copy to .env (git-ignored) and fill in locally. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8080
TRAVEL_BUFFER_MINUTES=30
OFFERED_PURPOSES=checkup,wound_care,blood_test,medication,other
ELIGIBLE_ROLES=nurse
BUSINESS_TIMEZONE=Asia/Jerusalem
PREDICTIVE_SERVICE_URL=http://localhost:8000
PREDICTIVE_TIMEOUT_SECONDS=5
# HMAC key shared with the DB row server_secrets.risk_attestation_secret (>=32 random bytes). Required for risk/alert writes.
RISK_ATTESTATION_SECRET=
# --- AI visit-summary DRAFT: opt-in, OFF by default. SYNTHETIC DATA ONLY in this phase (nothing identifying is sent, but this is not a privacy approval). ---
SUMMARY_ENABLED=false
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=25
LLM_MAX_OUTPUT_TOKENS=2000
# LLM_TEMPERATURE=0
# >=32 random chars; signs the provenance token. Independent of RISK_ATTESTATION_SECRET.
SUMMARY_SIGNING_SECRET=
SUMMARY_RATE_PER_MINUTE=6
