#!/usr/bin/env bash
# חוסם commit שמכניס סיסמאות/מפתחות חשופים בשורות שנוספו (staged diff).
# הפעלה חד-פעמית לכל clone: git config core.hooksPath .githooks
# עקיפה מכוונת (אם זה false positive): git commit --no-verify

set -euo pipefail

pattern='sb_secret_[A-Za-z0-9_-]+|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|(password|passwd|secret|api[_-]?key|access[_-]?token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{6,}'

files=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$files" ]; then
  exit 0
fi

found=0
while IFS= read -r file; do
  [ -f "$file" ] || continue
  matches=$(git diff --cached -- "$file" | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -EiI "$pattern" || true)
  if [ -n "$matches" ]; then
    echo "🚫 חשד לסיסמה/מפתח חשוף ב-$file:"
    echo "$matches" | sed 's/^/    /'
    found=1
  fi
done <<< "$files"

if [ "$found" -eq 1 ]; then
  echo ""
  echo "ה-commit נחסם. אם זו טעות (false positive): git commit --no-verify"
  exit 1
fi

exit 0
